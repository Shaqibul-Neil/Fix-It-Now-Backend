model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(120)

  description String? @db.Text
  overview    String? @db.Text

  image      String? @db.Text
  coverImage String? @map("cover_image") @db.Text

  tagline      String?  @db.Text
  commonIssues String[] @default([]) @map("common_issues")

  maintenanceType         TMaintenanceType @default(NONE) @map("maintenance_type")
  maintenanceIntervalDays Int?             @map("maintenance_interval_days")

  isActive Boolean @default(true) @map("is_active")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  services Service[]
  bookings Booking[]
  reviews  Review[]

  @@index([deletedAt])
  @@map("categories")
}
